# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Connection string for the dedicated Life Manager MySQL app user (never
# root), against the existing `life_manager` database.
DATABASE_URL=mysql://app_user:changeme@localhost:3306/life_manager

# Encryption/signing key for iron-session (see src/lib/auth/session.ts).
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme_at_least_32_characters_long
